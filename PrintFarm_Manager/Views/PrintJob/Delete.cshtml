@model PrintJobDeleteViewModel
@{
    ViewData["Title"] = "Изтриване на задание";
}
<h1>Изтриване на задание</h1>
<div class="alert alert-warning mt-3">
    Сигурни ли сте, че искате да изтриете <strong>@Model.Title</strong> от принтер <strong>@Model.PrinterName</strong>?
</div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button class="btn btn-danger" type="submit">Изтрий</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
