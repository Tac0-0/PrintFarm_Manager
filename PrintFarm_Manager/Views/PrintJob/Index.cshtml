@model IEnumerable<PrintJobIndexViewModel>
@{
    ViewData["Title"] = "Задания";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Задания за печат</h1>
        <p class="text-muted mb-0">Зависимата таблица. Името на принтера идва от свързаната таблица.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Добави задание</a>
</div>
<table class="table table-striped align-middle">
    <thead>
        <tr><th>Задание</th><th>Материал</th><th>Часове</th><th>Принтер</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Material</td>
            <td>@item.EstimatedHours</td>
            <td>@item.PrinterName</td>
            <td class="actions text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                <a asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Изтриване</a>
            </td>
        </tr>
    }
    </tbody>
</table>
