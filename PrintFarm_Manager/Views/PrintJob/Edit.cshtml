@model PrintJobEditViewModel
@{
    ViewData["Title"] = "Редакция на задание";
}
<h1>Редакция на задание</h1>
<div class="card p-4 mt-3" style="max-width: 650px;">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FilamentIds" class="form-label"></label>
            <select asp-for="FilamentIds" asp-items="ViewBag.Filaments" class="form-select" multiple size="6"></select>
            <div class="form-text">Изберете един или повече материала (Ctrl + щракване).</div>
            <a asp-controller="Filament" asp-action="Create">Добави нов материал</a>
            <span asp-validation-for="FilamentIds" class="text-danger d-block"></span>
        </div>
        <div class="mb-3">
            <label asp-for="EstimatedHours" class="form-label"></label>
            <input asp-for="EstimatedHours" class="form-control" type="number" step="0.1" min="0.1" max="500" />
            <span asp-validation-for="EstimatedHours" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PrinterId" class="form-label"></label>
            <select asp-for="PrinterId" asp-items="ViewBag.Printers" class="form-select">
                <option value="0">-- Изберете принтер --</option>
            </select>
            <span asp-validation-for="PrinterId" class="text-danger"></span>
        </div>
        <button class="btn btn-primary" type="submit">Запази промените</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
