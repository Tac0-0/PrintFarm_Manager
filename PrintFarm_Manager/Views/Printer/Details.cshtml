@model PrinterDetailsViewModel
@{
    ViewData["Title"] = "Детайли за принтер";
}
<h1>Детайли за принтер</h1>
<div class="card p-4 mt-3">
    <dl class="row mb-4">
        <dt class="col-sm-3">Име</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Модел</dt><dd class="col-sm-9">@Model.Model</dd>
        <dt class="col-sm-3">Местоположение</dt><dd class="col-sm-9">@Model.Location</dd>
        <dt class="col-sm-3">Статус</dt><dd class="col-sm-9">@(Model.IsOperational ? "Работи" : "Спрян")</dd>
    </dl>
    <h5>Свързани задания</h5>
    @if (Model.PrintJobs.Count == 0)
    {
        <p class="text-muted">Няма задания за този принтер.</p>
    }
    else
    {
        <ul>
        @foreach (var job in Model.PrintJobs)
        {
            <li>@job</li>
        }
        </ul>
    }
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редакция</a>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</div>
