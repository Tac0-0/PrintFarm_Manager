@model PrinterDeleteViewModel
@{
    ViewData["Title"] = "Изтриване на принтер";
}
<h1>Изтриване на принтер</h1>
<div class="alert alert-warning mt-3">
    Сигурни ли сте, че искате да изтриете <strong>@Model.Name</strong>?
    @if (Model.PrintJobsCount > 0)
    {
        <div class="mt-2">Свързаните задания (@Model.PrintJobsCount) също ще бъдат изтрити.</div>
    }
</div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button class="btn btn-danger" type="submit">Изтрий</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
