@model IEnumerable<FilamentIndexViewModel>
@{
    ViewData["Title"] = "Материали";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Материали за печат</h1>
    <a asp-action="Create" class="btn btn-primary">Добави материал</a>
</div>
<table class="table table-striped align-middle">
    <thead><tr><th>Материал</th><th>Цвят</th><th>Задания</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@(string.IsNullOrWhiteSpace(item.Color) ? "Неуточнен" : item.Color)</td>
            <td>@item.PrintJobsCount</td>
            <td class="actions text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                <a asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Изтриване</a>
            </td>
        </tr>
    }
    </tbody>
</table>
